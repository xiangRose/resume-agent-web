# ============================================================
# 模型提供方选择（三选一）：
#   hunyuan    （默认）直连腾讯混元 Hy3（TokenHub OpenAI 兼容接口）
#   codebuddy  走 CodeBuddy Agent SDK，支持读取本地文件
#   deepseek   直连 DeepSeek OpenAI 兼容接口（纯文本对话）
# ============================================================
MODEL_PROVIDER=hunyuan

# ---------- 腾讯混元 Hy3 模式（默认）----------
# 在 https://tokenhub.cloud.tencent.com 创建 API Key
HUNYUAN_API_KEY=your_hunyuan_key_here
# HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# HUNYUAN_MODEL=hy3                # 或 hy3-preview

# ---------- CodeBuddy 模式 ----------
# 在 https://www.codebuddy.cn 获取 API Key
# MODEL_PROVIDER=codebuddy
# CODEBUDDY_API_KEY=your_api_key_here
# CODEBUDDY_AUTH_TOKEN=            # 与 API Key 二选一
# CODEBUDDY_INTERNET_ENVIRONMENT=external
# CODEBUDDY_BASE_URL=              # 自建/内网网关时使用

# ---------- DeepSeek 模式 ----------
# 在 https://platform.deepseek.com 获取 API Key
# MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat     # 或 deepseek-reasoner

# 服务端端口（默认 3000）
# PORT=3000
